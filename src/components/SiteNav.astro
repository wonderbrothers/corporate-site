---
/* 固定ナビゲーション＋メニュードロワー（840px 以下）。トップページと INSIGHTS で共通。
   ・トップページ（onHome）では HERO の間は隠し、少しスクロールしたら出す（main.js）。
     それ以外のページでは最初から出しておき、各リンクはトップページの該当セクションへ飛ぶ。
   ・INSIGHTS は公開済みの記事が1本以上あるときだけ出す（記事が無い間はナビに出ない）。
   ・見た目は index.css（wb-nav / wb-drawer）。 */
import { getCopy, PATHS, type Lang } from '../lib/i18n';
import { hasInsights } from '../lib/insights';

interface Props {
  lang: Lang;
  onHome?: boolean;
  otherHref: string; // 言語切り替えの行き先（もう一方の言語の同じページ）
  current?: 'insights';
}
const { lang, onHome = false, otherHref, current } = Astro.props;
const t = await getCopy(lang);
const other: Lang = lang === 'ja' ? 'en' : 'ja';
const home = PATHS.home[lang];
const contactHref = PATHS.contact[lang];
const anchor = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
const homeHref = onHome ? '#top' : home;
const homeLabel = onHome ? t.nav.home : t.nav.homePage;

const nav = [
  { href: anchor('approach'), label: 'APPROACH' },
  { href: anchor('work'), label: 'WORK' },
  { href: anchor('lab'), label: 'LAB' },
  ...((await hasInsights(lang)) ? [{ href: PATHS.insights[lang], label: 'INSIGHTS', key: 'insights' }] : []),
  { href: anchor('about'), label: 'ABOUT' },
  { href: anchor('contact'), label: 'CONTACT', key: 'contact' },
];
const isCurrent = (item: { key?: string }) => (item.key && item.key === current ? 'page' : undefined);
---
  <!-- ナビゲーション：HERO を過ぎると上から現れる（JS 無効時は常に表示） -->
  <header class:list={['wb-nav wb-flow', { 'is-shown': !onHome }]} data-nav={onHome ? '' : undefined}>
    <a class="wb-nav__home" href={homeHref} aria-label={homeLabel}>
      <img class="wb-nav__logo" src="/images/horizontal-logo.svg" alt="" width="886" height="148" />
    </a>
    <nav class="wb-nav__menu" aria-label={t.nav.main}>
      <ul class="wb-nav__list">
        {nav.map((item) => (
          <li><a class="wb-nav__link" href={item.href} aria-current={isCurrent(item)}>{item.label}</a></li>
        ))}
        <li><a class="wb-nav__link wb-nav__lang" href={otherHref} hreflang={other} lang={other} aria-label={t.nav.switchName}>{t.nav.switchLabel}</a></li>
      </ul>
    </nav>
    <!-- 840px 以下：メニューボタン（ドロワーを開く） -->
    <button type="button" class="wb-nav__toggle" aria-label={t.nav.openMenu} aria-expanded="false" aria-controls="wb-drawer" data-drawer-open>
      <span class="wb-nav__bars" aria-hidden="true"></span>
    </button>
  </header>
  <!-- メニュードロワー（840px 以下）。CONTACT はリストに入れず、下部のボタンにする -->
  <div class="wb-drawer wb-flow" id="wb-drawer" data-drawer>
    <div class="wb-drawer__backdrop" data-drawer-close></div>
    <div class="wb-drawer__panel" role="dialog" aria-modal="true" aria-label={t.nav.menu}>
      <div class="wb-drawer__head">
        <a class="wb-nav__home" href={homeHref} aria-label={homeLabel} data-drawer-link>
          <img class="wb-nav__logo" src="/images/horizontal-logo.svg" alt="" width="886" height="148" />
        </a>
        <button type="button" class="wb-drawer__close" aria-label={t.nav.closeMenu} data-drawer-close>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 5L19 19M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <nav aria-label={t.nav.menu}>
        <ul class="wb-drawer__list">
          {nav.filter((item) => item.key !== 'contact').map((item) => (
            <li><a class="wb-drawer__link" href={item.href} aria-current={isCurrent(item)} data-drawer-link>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="wb-drawer__lang" href={otherHref} hreflang={other} lang={other}>{t.nav.switchName}</a>
      <a class="wb-drawer__contact" href={contactHref}>
        <span class="wb-drawer__contact-text">
          <span class="wb-drawer__contact-title">{t.nav.contactTitle}</span>
          {t.nav.contactNote && <span class="wb-drawer__contact-note" lang="en">{t.nav.contactNote}</span>}
        </span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </div>
  </div>
