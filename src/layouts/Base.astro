---
import "../styles/global.css";
// Cookie 同意（3サイト共通の正本）。?url でビルド時に内容ハッシュ付きのファイルとして配信される。
import consentSrc from "../scripts/wb-consent.js?url";

// ▼▼ 要設定（公開値。GTM コンテナ発行後に差し替え）▼▼
// Google タグマネージャーのコンテナID（https://tagmanager.google.com で発行）
// 例: "GTM-XXXXXXX" ― 空文字の間は計測タグを一切出力しない（同意バナーも出ない）。
// GA4（G-XXXXXXXXXX）はコードには書かず、GTM の管理画面側で設定する。
// GTM は wb-consent.js が「アクセス解析を許可した人」にだけ読み込む（Basic Consent Mode）。
const GTM_ID = "GTM-TXJXFJFH";
// ▲▲ 要設定 ▲▲

interface Props {
  title: string;
  description?: string;
  path?: string; // 例: "/", "/contact/", "/privacy/"
  ogType?: string;
  noindex?: boolean; // 404 など検索対象外にしたいページ用
}

const DEFAULT_DESC =
  "WONDER BROTHERS（株式会社ワンダーブラザース）は、まだ言葉になっていない課題や可能性を見つけ、実際につくり、その結果から学びながら答えを探すデザインスタジオです。新規サービス設計、UX/UI、PoC・プロトタイプ、プロダクト開発、DXを支援しています。";

const {
  title,
  description = DEFAULT_DESC,
  path = "/",
  ogType = "website",
  noindex = false,
} = Astro.props;

// Astro.site（=https://wonder-bros.com）を基準に絶対URLを生成
const base = (Astro.site?.href ?? "https://wonder-bros.com/").replace(/\/$/, "");
const canonical = base + path;
const ogImage = base + "/images/ogp.png";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Cookie 同意 + Google Consent Mode v2（Basic）
         同意の確認 → 許可済みのときだけ GTM を読み込む。dataLayer を触る他のどのスクリプトより前に置くこと。
         GTM のスニペットをここに直接書かないこと（同意前に読み込まれてしまう）。 -->
    <script is:inline src={consentSrc} data-gtm={GTM_ID} data-privacy="/privacy/"></script>

    <!-- 時間帯によるメインカラー切り替え（描画前に同期実行してチラつきを防ぐ） -->
    <script is:inline>
      (function () {
        var h = new Date().getHours();
        var t = h >= 5 && h < 12 ? "morning" : h >= 12 && h < 18 ? "afternoon" : "night";
        document.documentElement.setAttribute("data-time-of-day", t);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? "noindex, follow" : "all"} />
    <meta name="theme-color" content="#d45235" />
    <meta name="generator" content={Astro.generator} />

    <!-- OGP / Twitter -->
    <meta property="og:site_name" content="株式会社ワンダーブラザース" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="株式会社ワンダーブラザース" />
    <meta name="format-detection" content="telephone=no,email=no,address=no" />

    <!-- Fonts (Google Fonts CDN)
         矢印アイコンはインライン SVG（Material Icons のフォントは読み込まない。1文字のために描画を止めていたため） -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;600;700;800&display=swap"
    />

    <!-- ページ個別の <head> 追加（JSON-LD など） -->
    <slot name="head" />
  </head>
  <body>
    <!-- GTM の noscript 版（iframe）は置かない。JavaScript が無いと同意を確認できないため。 -->

    <slot />
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
