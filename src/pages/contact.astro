---
import Base from '../layouts/Base.astro';
import '../styles/contact.css';

// ▼▼ 要設定（どちらも公開値。発行後に差し替え）▼▼
// reCAPTCHA v3 サイトキー（https://www.google.com/recaptcha/admin で発行）
const RECAPTCHA_SITE_KEY = "6LcRDGstAAAAAKI0ivmFnZ4lTX45awYPYFYP9VWU";
// Cloudflare Worker のURL（デプロイ後の xxx.workers.dev）
const CONTACT_ENDPOINT = "https://wb-contact.sato-b0d.workers.dev";
// ▲▲ 要設定 ▲▲
---
<Base title="お問い合わせ | 株式会社ワンダーブラザース" description="株式会社ワンダーブラザース（WONDER BROTHERS）へのお問い合わせフォームです。新規サービスの設計、UX/UI、PoC・プロトタイプ、プロダクト開発、DX支援のご相談を、企画が固まる前の段階から受け付けています。3営業日を目安にご返信します。" path="/contact/">
  <script slot="head" is:inline src={`https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`}></script>
  <div class="container"><div class="render-canvas"><div class="StudioCanvas">
<div class="wb-box reveal cf-page">
                <div class="wb-box reveal cf-inner">
                  <a href="/" class="link wb-box reveal cf-home-link"
                    ><img class="wb-box cf-logo" alt="" src="../images/logo.svg"
                  /></a>
                  <div class="wb-box reveal cf-body">
                    <h1 class="text wb-box reveal cf-title">
                      弊社へのお問い合わせは<br />こちらのフォームより承っております。<br />
                    </h1>
                    <p class="text wb-box reveal cf-note">
                      ご返信に3営業日ほどお時間をいただいております。<br />3営業日を過ぎても返信がない場合は、お手数ですが再度お問い合わせをお願いいたします。
                    </p>
                    <form
                      id="contact-form"
                      name="contact form"
                      class="wb-box reveal cf-form"
                    >
                      <div class="wb-box reveal cf-field">
                        <div class="wb-box reveal cf-field__label">
                          <p class="text wb-box reveal cf-field__label-text">貴社名</p>
                          <p class="text wb-box reveal cf-field__required">*<br /></p>
                        </div>
                        <input
                          name="entry.1361955119"
                          placeholder="Your Company"
                          required=""
                          type="text"
                          autocomplete="off"
                          class="wb-box reveal cf-field__input"
                        />
                      </div>
                      <div class="wb-box reveal cf-field">
                        <div class="wb-box reveal cf-field__label">
                          <p class="text wb-box reveal cf-field__label-text">お名前</p>
                          <p class="text wb-box reveal cf-field__required">*<br /></p>
                        </div>
                        <input
                          name="entry.1729267472"
                          placeholder="Your Name"
                          required=""
                          type="text"
                          autocomplete="off"
                          class="wb-box reveal cf-field__input"
                        />
                      </div>
                      <div class="wb-box reveal cf-field-email">
                        <div class="wb-box reveal cf-field-email__label">
                          <p class="text wb-box reveal cf-field-email__label-text">メールアドレス</p>
                          <p class="text wb-box reveal cf-field-email__required">*<br /></p>
                        </div>
                        <input
                          name="entry.252485387"
                          placeholder="Email Address"
                          required=""
                          type="email"
                          autocomplete="off"
                          class="wb-box reveal cf-field-email__input"
                        />
                      </div>
                      <div class="wb-box reveal cf-field-message">
                        <div class="wb-box reveal cf-field-message__label">
                          <p class="text wb-box reveal cf-field-message__label-text">お問い合わせ内容</p>
                          <p class="text wb-box reveal cf-field-message__required">*<br /></p>
                        </div>
                        <textarea
                          name="entry.1277514805"
                          placeholder="Put message here"
                          required=""
                          class="wb-box reveal cf-field-message__input"
                        ></textarea>
                      </div>
                      <label class="wb-box reveal cf-consent"
                        ><input
                          name="entry.321540926"
                          value="プライバシーポリシーに同意する"
                          required=""
                          type="checkbox"
                          class="wb-box cf-consent__checkbox" /><span
                          class="text wb-box reveal cf-consent__text"
                          >プライバシーポリシーに同意して送信する<br /></span></label
                      ><button class="button wb-box reveal cf-submit">
                        <p class="text wb-box reveal cf-submit__text">この内容で送信する</p>
                        <i class="icon material-icons wb-box reveal cf-submit__icon"
                          ><svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8.59 16.59 13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg></i
                        >
                      </button>
                    </form>
                    <p class="form-error" role="alert" hidden>
                      送信に失敗しました。お手数ですが時間をおいて再度お試しください。
                    </p>
                    <div class="form-thanks" hidden>
                      <p class="thanks-title">お問い合わせありがとうございます</p>
                      <p class="thanks-text">ご記入いただいた情報は無事に送信されました。</p>
                      <a class="thanks-back" href="/">トップページへ戻る</a>
                    </div>
                  </div>
                </div>
                <footer class="wb-box reveal cf-footer">
                  <div class="wb-box reveal cf-footer__inner">
                    <p class="text wb-box reveal cf-footer__copyright">
                      © WONDER BROTHERS INC. All rights reserved.
                    </p>
                    <div class="wb-footer-links">
                      <a href="/privacy/" class="text link wb-box reveal cf-footer__privacy"
                        >Privacy Policy</a
                      >
                      <button type="button" class="text link wb-box reveal cf-footer__privacy wb-cookie-btn" data-wb-consent-open
                        >Cookie設定</button
                      >
                    </div>
                  </div>
                </footer>
              </div>
  </div></div></div>

  <script define:vars={{ siteKey: RECAPTCHA_SITE_KEY, endpoint: CONTACT_ENDPOINT }}>
    // reCAPTCHA v3 → Cloudflare Worker 経由で Google フォームへ送信
    const form = document.getElementById("contact-form");
    if (form) {
      const card = form.parentElement;
      const thanks = document.querySelector(".form-thanks");
      const errorBox = document.querySelector(".form-error");
      const btn = form.querySelector("button");

      // フォームへの最初の入力を1回だけ計測（contact_start）。入力内容は送らない。
      // dataLayer に積むだけで、GA へ届くのはアクセス解析を許可した人だけ（wb-consent.js）
      const onStart = () => {
        form.removeEventListener("input", onStart);
        (window.dataLayer = window.dataLayer || []).push({ event: "contact_start", form_name: "contact" });
      };
      form.addEventListener("input", onStart);

      const showError = () => {
        if (errorBox) errorBox.hidden = false;
        if (btn) btn.disabled = false;
      };

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        if (errorBox) errorBox.hidden = true;
        if (btn) btn.disabled = true;
        try {
          await new Promise((res) => grecaptcha.ready(res));
          const token = await grecaptcha.execute(siteKey, { action: "contact" });
          const fields = {};
          new FormData(form).forEach((v, k) => {
            if (k.indexOf("entry.") === 0) fields[k] = v;
          });
          const r = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, fields }),
          });
          const data = await r.json().catch(() => ({}));
          if (r.ok && data.ok) {
            // GTM へ送信完了を通知（GA4 のコンバージョン計測用）
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: "contact_submit",
              form_name: "contact",
            });
            // カード内の見出し・フォームを隠してお礼を表示
            Array.prototype.forEach.call(card.children, (c) => {
              if (c !== thanks) c.style.display = "none";
            });
            if (thanks) {
              thanks.hidden = false;
              thanks.scrollIntoView({ behavior: "smooth", block: "center" });
            }
          } else {
            showError();
          }
        } catch (err) {
          showError();
        }
      });
    }
  </script>
</Base>
