---
import Base from '../layouts/Base.astro';
import '../styles/contact.css';

// ▼▼ 要設定（どちらも公開値。発行後に差し替え）▼▼
// reCAPTCHA v3 サイトキー（https://www.google.com/recaptcha/admin で発行）
const RECAPTCHA_SITE_KEY = "6LcRDGstAAAAAKI0ivmFnZ4lTX45awYPYFYP9VWU";
// Cloudflare Worker のURL（デプロイ後の xxx.workers.dev）
const CONTACT_ENDPOINT = "https://wb-contact.sato-b0d.workers.dev";
// ▲▲ 要設定 ▲▲
---
<Base title="株式会社ワンダーブラザース | CONTACT" description="株式会社ワンダーブラザースは、デザインとブランディングの力で地域や企業の未来をつくるデザインスタジオ。デザインとテクノロジーの力で「あったらいいな」を実現する。" path="/contact/">
  <script slot="head" is:inline src={`https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`}></script>
  <div class="container"><div class="render-canvas"><div class="StudioCanvas">
<div class="sd reveal cf-page">
                <div class="sd reveal cf-inner">
                  <a href="../index.html" class="link sd reveal cf-home-link"
                    ><img class="sd cf-logo" alt="" src="../images/logo.svg"
                  /></a>
                  <div class="sd reveal cf-body">
                    <h4 class="text sd reveal cf-title">
                      弊社へのお問い合わせは<br />こちらのフォームより承っております。<br />
                    </h4>
                    <p class="text sd reveal cf-note">
                      ご返信に3営業日ほどお時間をいただいております。<br />3営業日を過ぎても返信がない場合は、お手数ですが再度お問い合わせをお願いいたします。
                    </p>
                    <form
                      id="contact-form"
                      name="contact form"
                      class="sd reveal cf-form"
                    >
                      <div class="sd reveal cf-field">
                        <div class="sd reveal cf-field__label">
                          <p class="text sd reveal cf-field__label-text">貴社名</p>
                          <p class="text sd reveal cf-field__required">*<br /></p>
                        </div>
                        <input
                          name="entry.1361955119"
                          placeholder="Your Company"
                          required=""
                          type="text"
                          autocomplete="off"
                          class="sd reveal cf-field__input"
                        />
                      </div>
                      <div class="sd reveal cf-field">
                        <div class="sd reveal cf-field__label">
                          <p class="text sd reveal cf-field__label-text">お名前</p>
                          <p class="text sd reveal cf-field__required">*<br /></p>
                        </div>
                        <input
                          name="entry.1729267472"
                          placeholder="Your Name"
                          required=""
                          type="text"
                          autocomplete="off"
                          class="sd reveal cf-field__input"
                        />
                      </div>
                      <div class="sd reveal cf-field-email">
                        <div class="sd reveal cf-field-email__label">
                          <p class="text sd reveal cf-field-email__label-text">メールアドレス</p>
                          <p class="text sd reveal cf-field-email__required">*<br /></p>
                        </div>
                        <input
                          name="entry.252485387"
                          placeholder="Email Address"
                          required=""
                          type="email"
                          autocomplete="off"
                          class="sd reveal cf-field-email__input"
                        />
                      </div>
                      <div class="sd reveal cf-field-message">
                        <div class="sd reveal cf-field-message__label">
                          <p class="text sd reveal cf-field-message__label-text">お問い合わせ内容</p>
                          <p class="text sd reveal cf-field-message__required">*<br /></p>
                        </div>
                        <textarea
                          name="entry.1277514805"
                          placeholder="Put message here"
                          required=""
                          class="sd reveal cf-field-message__input"
                        ></textarea>
                      </div>
                      <label class="sd reveal cf-consent"
                        ><input
                          name="entry.321540926"
                          value="プライバシーポリシーに同意する"
                          required=""
                          type="checkbox"
                          class="sd cf-consent__checkbox" /><span
                          class="text sd reveal cf-consent__text"
                          >プライバシーポリシーに同意して送信する<br /></span></label
                      ><button class="button sd reveal cf-submit">
                        <p class="text sd reveal cf-submit__text">この内容で送信する</p>
                        <i class="icon material-icons sd reveal cf-submit__icon"
                          >keyboard_arrow_right</i
                        >
                      </button>
                    </form>
                    <p class="form-error" role="alert" hidden>
                      送信に失敗しました。お手数ですが時間をおいて再度お試しください。
                    </p>
                    <div class="form-thanks" hidden>
                      <p class="thanks-title">お問い合わせありがとうございます</p>
                      <p class="thanks-text">ご記入いただいた情報は無事に送信されました。</p>
                      <a class="thanks-back" href="../index.html">トップページへ戻る</a>
                    </div>
                  </div>
                </div>
                <footer class="sd reveal cf-footer">
                  <div class="sd reveal cf-footer__inner">
                    <p class="text sd reveal cf-footer__copyright">
                      © WONDER BROTHERS INC. all rights reserved.
                    </p>
                    <a href="../privacy/index.html" class="text link sd reveal cf-footer__privacy"
                      >Privacy Policy</a
                    >
                  </div>
                </footer>
              </div>
  </div></div></div>

  <script define:vars={{ siteKey: RECAPTCHA_SITE_KEY, endpoint: CONTACT_ENDPOINT }}>
    // reCAPTCHA v3 → Cloudflare Worker 経由で Google フォームへ送信
    const form = document.getElementById("contact-form");
    if (form) {
      const card = form.parentElement;
      const thanks = document.querySelector(".form-thanks");
      const errorBox = document.querySelector(".form-error");
      const btn = form.querySelector("button");

      const showError = () => {
        if (errorBox) errorBox.hidden = false;
        if (btn) btn.disabled = false;
      };

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        if (errorBox) errorBox.hidden = true;
        if (btn) btn.disabled = true;
        try {
          await new Promise((res) => grecaptcha.ready(res));
          const token = await grecaptcha.execute(siteKey, { action: "contact" });
          const fields = {};
          new FormData(form).forEach((v, k) => {
            if (k.indexOf("entry.") === 0) fields[k] = v;
          });
          const r = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, fields }),
          });
          const data = await r.json().catch(() => ({}));
          if (r.ok && data.ok) {
            // カード内の見出し・フォームを隠してお礼を表示
            Array.prototype.forEach.call(card.children, (c) => {
              if (c !== thanks) c.style.display = "none";
            });
            if (thanks) {
              thanks.hidden = false;
              thanks.scrollIntoView({ behavior: "smooth", block: "center" });
            }
          } else {
            showError();
          }
        } catch (err) {
          showError();
        }
      });
    }
  </script>
</Base>
