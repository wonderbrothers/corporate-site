---
// 英語版 INSIGHTS 記事（/en/insights/xxx/）。記事は src/content/insights/YYYY-MM-DD-xxx/en.md、型は src/components/InsightArticle.astro
import InsightArticle from '../../../components/InsightArticle.astro';
import { getInsights } from '../../../lib/insights';

export async function getStaticPaths() {
  return (await getInsights('en')).map((insight) => ({ params: { slug: insight.slug }, props: { insight } }));
}
const { insight } = Astro.props;
---
<InsightArticle lang="en" insight={insight} />
