    inLanguage: "ja",
    publisher: { "@id": "https://wonder-bros.com/#organization" },
  },
]);

/* ---------- ナビゲーション ---------- */
const nav = [
  { href: "#approach", label: "APPROACH" },
  { href: "#work", label: "WORK" },
  { href: "#lab", label: "LAB" },
  { href: "#about", label: "ABOUT" },
  { href: "#contact", label: "CONTACT" },
];

/* ---------- 02 APPROACH：DISCOVER / MAKE / LEARN ---------- */
const principles = [
  {
    num: "01",
    en: "Discover",
    ja: "見つける",
    icon: "images/deco-halftone.svg",
    textJa:
      "人の行動や業務、環境、情報の流れを観察し、まだ言葉になっていない課題を整理します。依頼の背景も一緒にひもときながら、取り組むべき問題と、最初に確かめることを見極めます。",
    textEn:
      "We observe people, workflows, environments, and information flows to uncover needs and problems that have not yet been clearly articulated. Together, we explore the context behind the brief and identify the problem to address and what to test first.",
  },
  {
    num: "02",
    en: "Make",
    ja: "つくる",
    icon: "images/deco-dots.svg",
    textJa:
      "問いや仮説を、実際に試せる形にします。画面、プロトタイプ、サービス体験など、確かめたいことに合わせて、つくるものと範囲を決めます。",
    textEn:
      "We turn questions and hypotheses into something people can try. What we make, and how much we build, depends on what we need to test — from an interface or prototype to a service experience.",
  },
  {
    num: "03",
    en: "Learn",
    ja: "学ぶ",
    icon: "images/deco-spiral.svg",
    textJa:
      "実際の使われ方や反応から、想定との違いや新たな課題を整理します。得られたことをもとに、開発へ進むか、見直して再び試すか、取り組みを止めるかを検討します。",
    textEn:
      "We examine real use and feedback to understand where our assumptions differ from what happens and what new issues emerge. What we learn helps us decide whether to move into development, revise and test again, or stop.",
  },
];

/* ---------- 03 CLIENT WORK：サービス ---------- */
const services = [
  {
    en: "New Service Design",
    ja: "新規サービス設計",
    textJa: "構想やアイデアを整理し、誰のどんな課題を解決するサービスなのかを具体化します。提供する価値と、最初に確かめることを明らかにします。",
    textEn: "We organize early concepts and ideas to define whose problem the service solves. We clarify the value it offers and what to test first.",
  },
  {
    en: "UX / UI Design",
    ja: "UX/UIデザイン",
    textJa: "利用者の行動や利用状況をもとに、情報の構成と操作の流れを設計します。複雑なサービスでも、必要な情報を見つけやすく、迷わず使える体験を目指します。",
    textEn: "We design information structure and user flows based on how people behave and the situations they use a service in. Even for complex services, we aim for experiences where people can find what they need and use it without getting lost.",
  },
  {
    en: "PoC Design & Validation",
    ja: "PoC設計・検証",
    poc: true, // 本文はテンプレート側（強調コピー・本文・3つの観点・注記）
  },
  {
    en: "Product Development",
    ja: "プロダクト開発",
    textJa: "検証で見えてきた方向性をもとに、実際に使われるプロダクトへと具体化します。必要に応じてエンジニアと連携し、UX/UIの設計から実装、リリース後の改善まで関わります。",
    textEn: "We shape the direction that emerges from validation into a product people actually use. Working with engineers where needed, we are involved from UX/UI design through implementation and post-release improvement.",
  },
  {
    en: "DX / Service Transformation",
    ja: "DX・サービス変革",
    textJa: "利用者、業務、情報、システムの関係を整理し、既存の業務やサービスのどこを変えるべきかを明らかにします。小さな検証も取り入れながら、現場で使える仕組みへと改善します。",
    textEn: "We map how users, operations, information, and systems relate to one another to identify what needs to change in existing operations and services. We test changes on a small scale to help develop processes and services that work in practice.",
  },
