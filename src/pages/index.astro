---
<Base title="株式会社ワンダーブラザース｜答えのない問いを、つくることで確かめる。" description={DESCRIPTION} path="/">
  <script type="application/ld+json" set:html={jsonLd} slot="head" is:inline></script>
  <div class="container"><div class="render-canvas">
  <!-- ナビゲーション：HERO を過ぎると上から現れる（JS 無効時は常に表示） -->
  <header class="wb-nav wb-flow" data-nav>
    <a class="wb-nav__home" href="#top" aria-label="ページの先頭へ">
      <img class="wb-nav__logo" src="images/horizontal-logo.svg" alt="" width="886" height="148" />
    </a>
    <nav class="wb-nav__menu" aria-label="メインナビゲーション">
      <ul class="wb-nav__list">
        {nav.map((item) => (
          <li><a class="wb-nav__link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <!-- 840px 以下：メニューボタン（ドロワーを開く） -->
    <button type="button" class="wb-nav__toggle" aria-label="メニューを開く" aria-expanded="false" aria-controls="wb-drawer" data-drawer-open>
      <span class="wb-nav__bars" aria-hidden="true"></span>
    </button>
  </header>
  <!-- メニュードロワー（840px 以下）。CONTACT はリストに入れず、下部のボタンにする -->
  <div class="wb-drawer wb-flow" id="wb-drawer" data-drawer>
    <div class="wb-drawer__backdrop" data-drawer-close></div>
    <div class="wb-drawer__panel" role="dialog" aria-modal="true" aria-label="メニュー">
      <div class="wb-drawer__head">
        <a class="wb-nav__home" href="#top" aria-label="ページの先頭へ" data-drawer-link>
          <img class="wb-nav__logo" src="images/horizontal-logo.svg" alt="" width="886" height="148" />
        </a>
        <button type="button" class="wb-drawer__close" aria-label="メニューを閉じる" data-drawer-close>
