---
import Base from '../layouts/Base.astro';
import '../styles/index.css';

/* ==================================================================
   トップページのコピーはここにまとめてある（文言の修正はこの frontmatter だけで済む）。
   構成・分類・コピーの方針は docs/site-restructure-2026-09.md を参照。

   表記ルール（docs にも記載）
   - 「DISCOVER. MAKE. LEARN.」／「見つける。つくる。学ぶ。」で統一。
     DML・D.M.L.・D/M/L などの省略形や、Discovery Phase などの言い換えは使わない。
   - 旧4段階（Discover / Design / Build / Learn）は使わない。Design と Build は Make に統合。
================================================================== */

const DESCRIPTION =
  "WONDER BROTHERS（株式会社ワンダーブラザース）は、まだ言葉になっていない課題や可能性を見つけ、実際につくり、その結果から学びながら答えを探すデザインスタジオです。新規サービス設計、UX/UI、PoC・プロトタイプ、プロダクト開発、DXを支援しています。";

const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "株式会社ワンダーブラザース",
    alternateName: "WONDER BROTHERS INC.",
    url: "https://wonder-bros.com/",
    logo: "https://wonder-bros.com/images/logo-mark.svg",
    image: "https://wonder-bros.com/images/ogp.png",
    slogan: "答えのない問いを、つくることで確かめる。",
    description: DESCRIPTION,
    foundingDate: "2020-04-07",
    founder: { "@type": "Person", name: "佐藤大志" },
    address: {
      "@type": "PostalAddress",
      postalCode: "150-0043",
      addressRegion: "東京都",
      addressLocality: "渋谷区",
      streetAddress: "道玄坂1-10-8 渋谷道玄坂東急ビル2F-C",
      addressCountry: "JP",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "株式会社ワンダーブラザース",
    url: "https://wonder-bros.com/",
    inLanguage: "ja",
  },
]);

/* ---------- ナビゲーション ---------- */
const nav = [
  { href: "#approach", label: "APPROACH" },
  { href: "#work", label: "WORK" },
  { href: "#lab", label: "LAB" },
  { href: "#about", label: "ABOUT" },
  { href: "#contact", label: "CONTACT" },
];

/* ---------- 02 APPROACH：DISCOVER / MAKE / LEARN ---------- */
const principles = [
  {
    num: "01",
    en: "Discover",
    ja: "見つける",
    icon: "images/deco-halftone.webp",
    textJa:
      "人、行動、環境、業務、情報を観察し、まだ言葉になっていない課題や可能性を見つけます。依頼された課題をそのまま受け取るのではなく、利用者の話を聞き、業務や情報の流れを整理しながら、本当に向き合うべき問いを定めます。",
    textEn:
      "We observe people, behavior, environments, systems, and information to uncover questions that have not yet been clearly defined. Rather than taking a brief at face value, we talk to users and map how work and information actually flow until we know which question is worth answering.",
  },
  {
    num: "02",
    en: "Make",
    ja: "つくる",
    icon: "images/deco-dots.gif",
    textJa:
      "問いや仮説を、考えるだけで終わらせず、実際に触れられる形にします。サービス、体験、UI、プロトタイプ、プロダクトと、必要な形は案件ごとに違います。形にして初めて見えることがあるので、私たちはデザインと実装を分けずに進めます。",
    textEn:
      "We turn hypotheses into experiences, prototypes, services, and products that can actually be used and tested. The form changes from project to project. Some things only become clear once they exist, so we don't separate designing from building.",
  },
  {
    num: "03",
    en: "Learn",
    ja: "学ぶ",
    icon: "images/deco-spiral.gif",
    textJa:
      "つくったものへの反応、使われ方、結果、違和感、予想外の出来事から学びます。見直すのは、つくったものだけではありません。必要であれば、最初に立てた問いや仮説そのものを問い直します。",
    textEn:
      "We learn from real behavior, feedback, outcomes, and the unexpected. Then we refine not only the solution, but the original question as well.",
  },
];

/* ---------- 03 CLIENT WORK：サービス ---------- */
const services = [
  {
    en: "New Service Design",
    ja: "新規サービス設計",
    textJa: "まだ曖昧な構想やアイデアを整理し、ユーザー価値、サービス構造、体験、必要な機能を設計します。",
    textEn: "We shape early ideas into a clear service: who it is for, what value it creates, how it works, and what it needs.",
  },
  {
    en: "UX / UI Design",
    ja: "UX/UIデザイン",
    textJa: "ユーザーの行動、情報構造、利用シーンを整理し、複雑なサービスを理解しやすく使いやすい体験に変えます。",
    textEn: "We untangle behavior, information, and context to make complex services easy to understand and use.",
  },
  {
    en: "PoC / Prototype",
    ja: "PoC/プロトタイプ",
    textJa: "アイデアを早い段階で体験できる形にし、ユーザーや関係者と検証できる状態をつくります。",
    textEn: "We make ideas tangible early, so they can be tested with users and stakeholders before big decisions are made.",
  },
  {
    en: "Product Development",
    ja: "プロダクト開発",
    textJa: "デザインだけで終わらせず、必要に応じてエンジニアと連携し、実際に利用できるプロダクトとして実装します。",
    textEn: "We don't stop at design. Working with engineers where needed, we build products people can actually use.",
  },
  {
    en: "DX / Service Transformation",
    ja: "DX・サービス変革",
    textJa: "既存の業務やサービスの構造を整理し、デジタルを活用した新しい体験や業務プロセスへ再設計します。",
    textEn: "We map how existing operations and services work, then redesign them into new digital experiences and processes.",
  },
];

/* ---------- 04 SELECTED WORK ----------
   業種 × 問い × 支援内容で見せる。published: true のものだけ表示する。
   掲載しないもの：クライアント名／固有のサービス名・プロジェクト名／機密性の高い数値／
   公開許可のない画面／特定企業を推測できる内部情報／実際には行っていない工程／成果数値の創作。
   業種は「損害保険会社」「金融サービス事業者」程度の粒度にとどめる。
   下書き（published: false）は、実際の案件に基づいて問い・工程を記入してから公開する。 */
const cases = [
  {
    published: true,
    industryEn: "INSURANCE",
    industryJa: "損害保険会社",
    questionJa: "どうすれば、複雑な保険情報をユーザーが迷わず理解できる体験にできるか。",
    questionEn: "How can complex insurance information become something people can understand without getting lost?",
    steps: {
      discover: {
        ja: "商品、契約、手続きに関する情報構造とユーザー行動を整理し、理解や判断が難しくなるポイントを特定。",
        en: "We mapped the information structure of products, policies, and procedures against user behavior to pinpoint where understanding and decisions broke down.",
      },
      make: {
        ja: "UX、情報設計、UI、プロトタイプを通じて、複雑な情報を利用者が理解しやすい体験へ具体化。",
        en: "Through UX, information architecture, UI, and prototypes, we turned complex information into an experience users could follow.",
      },
      learn: {
        ja: "関係者レビューや検証を通じて課題を整理し、実装可能な体験へ更新。",
        en: "Stakeholder reviews and validation surfaced the remaining issues, and we refined the experience into something ready to build.",
      },
    },
  },
  {
    published: true,
    industryEn: "FINANCIAL SERVICES",
    industryJa: "金融サービス事業者",
    questionJa: "新しいデジタルサービスの構想を、どうすれば関係者が同じ像を見ながら判断できる形にまとめられるか。",
    questionEn: "How can an early idea for a digital service take a shape everyone can see — and decide on — together?",
    steps: {
      discover: {
        ja: "構想の背景、想定する利用者、既存の業務や制約を整理し、検証すべき論点を明確化。",
        en: "We laid out the idea's background, intended users, and existing operations and constraints to clarify what needed to be tested.",
      },
      make: {
        ja: "サービス像を画面とプロトタイプで可視化。関係者が体験として確かめられる状態を構築。",
        en: "We visualized the service through screens and prototypes so stakeholders could experience it, not just read about it.",
      },
      learn: {
        ja: "検討の中で得た意見や課題を整理し、次の意思決定と開発に向けた要件へ反映。",
        en: "We organized the feedback and issues that came up and carried them into requirements for the next decision and for development.",
      },
    },
  },
  {
    published: true,
    industryEn: "ENTERTAINMENT",
    industryJa: "エンターテインメント事業者",
    questionJa: "新しいサービスの構想を、事業性とユーザー体験の両面から、どう実装可能な形へ落とし込むか。",
    questionEn: "How can a new service concept be shaped into something buildable — with both the business and the user experience in mind?",
    steps: {
      discover: {
        ja: "事業の目的や想定するユーザー行動を整理し、サービスとして成立させるために必要な体験と機能の優先順位を明確化。",
        en: "We clarified the business goals and expected user behavior, then set priorities for the experiences and features the service needed to work.",
      },
      make: {
        ja: "仮説をもとにUX、UI、プロトタイプを設計し、開発へつながりやすい情報構造とデザインルールを整備。",
        en: "Working from hypotheses, we designed the UX, UI, and prototypes, and set up an information structure and design rules that carry smoothly into development.",
      },
      learn: {
        ja: "関係者とのレビューや検証を重ね、事業要件とユーザー体験の両方を満たす形へ調整し、実装可能なプロダクト構造へ更新。",
        en: "Through repeated reviews and validation with stakeholders, we balanced business requirements with user experience and refined the product structure until it was ready to build.",
      },
    },
  },
  /* ↓ 下書き（非公開）。業種の枠のみ。実案件に基づいて記入してから published: true に。 */
  { published: false, industryEn: "FINTECH / PAYMENT", industryJa: "決済サービス事業者", questionJa: "", questionEn: "", steps: null },
  { published: false, industryEn: "ENTERPRISE", industryJa: "事業会社", questionJa: "", questionEn: "", steps: null },
  { published: false, industryEn: "INSURANCE PLATFORM", industryJa: "保険プラットフォーム", questionJa: "", questionEn: "", steps: null },
  { published: false, industryEn: "DIGITAL SERVICE", industryJa: "デジタルサービス事業者", questionJa: "", questionEn: "", steps: null },
].filter((c) => c.published && c.steps);

/* ---------- 05 WONDER LAB ---------- */
const labProjects = [
  {
    key: "64monsters",
    name: "64MONSTERS",
    logo: "images/64monsters-logo-animated.svg",
    url: "https://64monsters.wonder-bros.com/",
    urlLabel: "64monsters.wonder-bros.com",
    themeJa: "人をどう理解するか。",
    themeEn: "Understanding people",
    questionJa: "人を「ユーザー」という言葉だけで理解できるだろうか。",
    questionEn: "Can we understand a person simply by calling them a “user”?",
    contextJa:
      "UXデザインでは、ユーザーを理解することからプロジェクトが始まります。しかし実際の人間は、属性やペルソナ、ひとつのタイプだけでは説明できません。そこで「もっと人そのものを理解する方法をつくれないか」という問いから、64MONSTERSをつくりました。",
    contextEn:
      "In UX design, every project begins with understanding the user. But real people can't be explained by demographics, personas, or a single type. 64MONSTERS started with a question: could we build a better way to understand the person behind the user?",
    steps: {
      discover: {
        ja: "ユーザーを属性やひとつのタイプだけで捉えることの限界に着目し、人をより多面的に捉える方法はないか、という問いを設定。",
        en: "We noticed the limits of seeing users through demographics or a single type, and asked how people might be seen from more angles.",
      },
      make: {
        ja: "複数の軸から、その人のいまの傾向を捉える診断体験を制作。タイプだけでなく、スコアや揺れ、繰り返し診断したときの変化まで見られるように設計。",
        en: "We built an assessment that reads a person's current tendencies across several axes — showing not just a type, but scores, fluctuations, and how results shift over repeated sessions.",
      },
      learn: {
        ja: "人を固定したタイプとしてではなく「変化する状態」として捉える可能性を、実際の診断体験を通じて探究中。",
        en: "Through real use, we are exploring what it means to see a person not as a fixed type, but as a state that changes.",
      },
    },
  },
  {
    key: "rensougame",
    name: "RENSOU GAME",
    logo: "images/rensougame-logo-animated.svg",
    url: "https://rensougame.wonder-bros.com/",
    urlLabel: "rensougame.wonder-bros.com",
    themeJa: "どう考え、仮説を確かめるか。",
    themeEn: "Thinking and testing hypotheses",
    questionJa: "ニュースを読むだけで、考える力は身につくだろうか。",
    questionEn: "Does reading the news alone really teach us how to think?",
    contextJa:
      "ひとつの出来事が起きたとき、その影響はひとつでは終わりません。経済、企業、暮らし、市場へと連鎖していきます。けれど普段のニュース体験では、結果を受け取るだけになりがちです。",
    contextEn:
      "When something happens, its effects rarely stop in one place. They ripple through the economy, companies, daily life, and markets. Yet most of the time, we simply take in the news and move on.",
    steps: {
      discover: {
        ja: "ニュースを読むことが、必ずしも「その先を考えること」や「仮説を確かめること」につながっていない点に着目。",
        en: "We noticed that reading the news doesn't necessarily lead to thinking ahead, or to testing what we think will happen.",
      },
      make: {
        ja: "ニュースを起点に、何が起きるか、その次に何が起きるか、別のシナリオはあるか、実際にはどうなったかを考える体験を、ゲームとして制作。",
        en: "We built a game that starts from a news story and asks: what happens next, what happens after that, what else could happen — and what actually happened?",
      },
      learn: {
        ja: "目的は未来を当てることではなく、自分がどう考えたのかを後から振り返ること。仮説と結果を照らし合わせ、考えるプロセスそのものから学ぶ仕組み。",
        en: "The goal isn't to predict the future. It's to look back at how we reasoned — forming a hypothesis, checking it against what happened, and learning from the process itself.",
      },
    },
  },
  {
    key: "forest",
    name: "FOREST EXPERIMENT",
    logo: "images/mori-logo.svg",
    url: null,
    urlLabel: null,
    themeJa: "価値をどう見つけるか。",
    themeEn: "Discovering value",
    questionJa: "価値がまだわからないものから、価値を見つけることはできるだろうか。",
    questionEn: "Can we discover value before we know what we are looking for?",
    contextJa:
      "北海道の森を取得したことから始まった実験です。そこには水道も下水も電気もなく、森林なので土地の境界さえ目でははっきり見えません。都市では当たり前にある前提が、ほとんど存在しない場所です。だから「ここで何をつくるか」を先に決めるのではなく、「この場所には何があるのか」から考えることにしました。",
    contextEn:
      "This experiment began when we acquired a forest in Hokkaido. There is no running water, no sewer, no electricity — and in the woods, even the property lines are hard to see. Almost nothing a city takes for granted is there. So instead of deciding what to build, we started by asking what the place already had.",
    steps: {
      discover: {
        ja: "森に入り、環境、植物、土地の特徴を観察して、この場所にどんな可能性があるのかを探索。",
        en: "We walked the forest, observing its environment, plants, and terrain to see what possibilities it might hold.",
      },
      make: {
        ja: "実際に森に触れて試し、トドマツの枝葉から精油を抽出。成分分析まで実施。",
        en: "We got our hands in it — extracting essential oil from Todo fir branches and leaves, and analyzing its composition.",
      },
      learn: {
        ja: "手を動かすことで見えてきた、この森の特徴と可能性。そして「価値を先に決めるのではなく、実験から見つける」という視点。",
        en: "Working with our hands showed us what makes this forest distinctive, and taught us to find value through experiments rather than define it in advance.",
      },
    },
  },
];

const stepLabels = [
  { key: "discover", label: "DISCOVER" },
  { key: "make", label: "MAKE" },
  { key: "learn", label: "LEARN" },
];

/* ---------- 07 ABOUT ---------- */
const company = [
  { label: "会社名", ja: "株式会社ワンダーブラザース", en: "WONDER BROTHERS INC." },
  {
    label: "所在地",
    ja: "〒150-0043 東京都渋谷区道玄坂1-10-8 渋谷道玄坂東急ビル2F-C",
    en: "2F-C, Shibuya Dogenzaka Tokyu Building, 1-10-8 Dogenzaka, Shibuya-ku, Tokyo 150-0043, Japan",
  },
  { label: "設立", ja: "2020年4月7日", en: "Established: April 7, 2020" },
  { label: "代表取締役", ja: "佐藤大志", en: "Representative Director: Taishi Sato" },
  {
    label: "事業内容",
    list: ["New Service Design", "UX / UI Design", "PoC / Prototype", "Product Development", "DX / Service Transformation"],
    en: "新規サービス設計、UX/UIデザイン、PoC/プロトタイプ、プロダクト開発、DX・サービス変革の支援",
  },
  { label: "資本金", ja: "10,000,000円", en: "Capital: 10 million yen" },
];
---
<Base title="株式会社ワンダーブラザース｜答えのない問いを、つくることで確かめる。" description={DESCRIPTION} path="/">
  <script type="application/ld+json" set:html={jsonLd} slot="head" is:inline></script>
  <div class="container"><div class="render-canvas">
  <!-- ナビゲーション：HERO を過ぎると上から現れる（JS 無効時は常に表示） -->
  <header class="wb-nav wb-flow" data-nav>
    <a class="wb-nav__home" href="#top" aria-label="ページの先頭へ">
      <img class="wb-nav__logo" src="images/horizontal-logo.svg" alt="" width="886" height="148" />
    </a>
    <nav class="wb-nav__menu" aria-label="メインナビゲーション">
      <ul class="wb-nav__list">
        {nav.map((item) => (
          <li><a class="wb-nav__link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <!-- 840px 以下：メニューボタン（ドロワーを開く） -->
    <button type="button" class="wb-nav__toggle" aria-label="メニューを開く" aria-expanded="false" aria-controls="wb-drawer" data-drawer-open>
      <span class="wb-nav__bars" aria-hidden="true"></span>
    </button>
  </header>
  <!-- メニュードロワー（840px 以下）。CONTACT はリストに入れず、下部のボタンにする -->
  <div class="wb-drawer wb-flow" id="wb-drawer" data-drawer>
    <div class="wb-drawer__backdrop" data-drawer-close></div>
    <div class="wb-drawer__panel" role="dialog" aria-modal="true" aria-label="メニュー">
      <div class="wb-drawer__head">
        <a class="wb-nav__home" href="#top" aria-label="ページの先頭へ" data-drawer-link>
          <img class="wb-nav__logo" src="images/horizontal-logo.svg" alt="" width="886" height="148" />
        </a>
        <button type="button" class="wb-drawer__close" aria-label="メニューを閉じる" data-drawer-close>
          <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M5 5L19 19M19 5L5 19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
        </button>
      </div>
      <nav aria-label="メニュー">
        <ul class="wb-drawer__list">
          {nav.filter((item) => item.href !== "#contact").map((item) => (
            <li><a class="wb-drawer__link" href={item.href} data-drawer-link>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <a class="wb-drawer__contact" href="contact/index.html">
        <span class="wb-drawer__contact-text">
          <span class="wb-drawer__contact-title">お問い合わせ</span>
          <span class="wb-drawer__contact-note" lang="en">CONTACT</span>
        </span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </div>
  </div>
  <div class="StudioCanvas">
<div class="wb-box reveal wb-page" id="top">
                <!-- ============ 01 HERO ============ -->
                <div class="wb-box reveal wb-intro">
                  <section class="wb-box reveal wb-hero" data-hero>
                    <img class="wb-box wb-hero__image" alt="" src="images/hero.webp" /><h1 class="wb-hero__heading"><img
                      class="wb-box wb-hero__logo"
                      alt="株式会社ワンダーブラザース"
                      src="images/logo.svg"
                    /></h1><img class="wb-box wb-hero__mark" alt="" src="images/logo-mark.svg" />
                    <div class="wb-box wb-hero__scroll">
                      <p class="text wb-box reveal wb-hero__scroll-label">SCROLL</p>
                      <div class="wb-box reveal wb-hero__scroll-line"></div>
                    </div>
                  </section>
                  <section class="wb-box reveal wb-statement wb-flow" aria-labelledby="statement-title">
                    <div class="wb-box wb-statement__list" lang="en">
                      <p class="text wb-box reveal wb-statement__line wb-statement__line--1">Build to explore</p>
                      <p class="text wb-box reveal wb-statement__line wb-statement__line--2">the unanswered.</p>
                    </div>
                    <div class="wb-statement__body">
                      <h2 id="statement-title" class="reveal wb-statement__title">答えのない問いを、<br />つくることで確かめる。</h2>
                      <p class="reveal wb-statement__ja">
                        WONDER BROTHERSは、人や社会の中にある、まだ言葉になっていない課題や可能性を見つけ、実際につくり、その結果から学びながら答えを探すデザインスタジオです。
                      </p>
                      <p class="reveal wb-statement__en" lang="en">
                        WONDER BROTHERS is a design studio that explores unanswered questions by finding what matters, making things real, and learning from what happens next.
                      </p>
                      <p class="reveal wb-principle">
                        <span class="wb-principle__en" lang="en">DISCOVER. MAKE. LEARN.</span>
                        <span class="wb-principle__ja">見つける。つくる。学ぶ。</span>
                      </p>
                    </div>
                  </section>
                </div>

                <div class="wb-box reveal wb-lower">
                  <!-- ============ 02 APPROACH ============ -->
                  <section id="approach" class="wb-sec wb-flow" aria-labelledby="approach-title">
                    <div class="wb-sec__inner">
                      <div class="wb-sec__head">
                        <h2 id="approach-title" class="reveal wb-display wb-display--approach" lang="en">APPROACH</h2>
                        <p class="reveal wb-sec__sub" lang="en">We think by making.</p>
                      </div>
                      <div class="wb-sec__lead">
                        <p class="reveal wb-sec__heading">考えるだけで終わらせない。</p>
                        <div class="reveal wb-sec__text">
                          <p>新しいサービスやプロダクトをつくるとき、最初から正しい答えが見えていることはほとんどありません。だからWONDER BROTHERSでは、まず人や状況を観察して問いを見つけ、その問いを実際に形にし、そこから得たことを次の判断につなげます。</p>
                          <p>私たちは、この「見つける、つくる、学ぶ」という循環を、クライアントワークにも自分たちの実験にも、同じように用いています。</p>
                        </div>
                        <div class="reveal wb-sec__text-en" lang="en">
                          <p>When building a new service or product, the right answer is rarely clear from the start. So we begin by observing people and situations to find the real question, give that question a form, and let what we learn shape the next decision.</p>
                          <p>We use the same cycle — discover, make, learn — in our client work and in our own experiments.</p>
                        </div>
                      </div>
                      <ol class="wb-dml">
                        {principles.map((p) => (
                          <li class="reveal wb-dml__item">
                            <img class="wb-dml__icon" src={p.icon} alt="" width="232" height="232" />
                            <p class="wb-dml__num" lang="en">{p.num}</p>
                            <h3 class="wb-dml__title"><span lang="en">{p.en}</span><span class="wb-dml__title-ja">{p.ja}</span></h3>
                            <p class="wb-dml__ja">{p.textJa}</p>
                            <p class="wb-dml__en" lang="en">{p.textEn}</p>
                          </li>
                        ))}
                      </ol>
                      <div class="reveal wb-cycle">
                        <p class="wb-cycle__flow" lang="en" aria-label="Discover, Make, Learn, and back to Discover">
                          <span class="wb-cycle__step">Discover</span><span class="wb-cycle__arrow" aria-hidden="true">→</span><span class="wb-cycle__step">Make</span><span class="wb-cycle__arrow" aria-hidden="true">→</span><span class="wb-cycle__step">Learn</span><span class="wb-cycle__arrow" aria-hidden="true">→</span><span class="wb-cycle__step wb-cycle__step--return">Discover</span>
                        </p>
                        <p class="wb-cycle__ja">学んだことが、次の問いになる。</p>
                        <p class="wb-cycle__en" lang="en">What we learn becomes the next question.</p>
                      </div>
                    </div>
                  </section>

                  <!-- ============ 03 CLIENT WORK ============ -->
                  <section id="work" class="wb-sec wb-flow" aria-labelledby="work-title">
                    <div class="wb-sec__inner">
                      <div class="wb-sec__head">
                        <h2 id="work-title" class="reveal wb-display wb-display--work" lang="en">CLIENT WORK</h2>
                        <p class="reveal wb-sec__sub" lang="en">We help organizations turn early ideas into real products and services.</p>
                      </div>
                      <div class="wb-sec__lead">
                        <p class="reveal wb-sec__heading">企業の「まだ形になっていない」を、一緒につくる。</p>
                        <div class="reveal wb-sec__text">
                          <p>新規サービスやデジタルプロダクトを中心に、構想の整理からサービス設計、UX/UI、PoC、プロトタイピング、開発、既存サービスの改善まで、必要な領域を横断して支援します。決まった工程を当てはめるのではなく、いま何を明らかにし、何を形にすべきかをプロジェクトごとに見極めながら進めます。</p>
                        </div>
                        <div class="reveal wb-sec__text-en" lang="en">
                          <p>We work across whatever a project needs — from shaping an early concept to service design, UX/UI, PoC, prototyping, development, and improving services already in use. Rather than applying a fixed process, we work out with you what needs to be understood next, and what needs to be built.</p>
                        </div>
                      </div>
                      <ul class="wb-services">
                        {services.map((s) => (
                          <li class="reveal wb-services__item">
                            <div class="wb-services__name">
                              <h3 class="wb-services__en" lang="en">{s.en}</h3>
                              <p class="wb-services__ja">{s.ja}</p>
                            </div>
                            <div class="wb-services__body">
                              <p class="wb-services__text">{s.textJa}</p>
                              <p class="wb-services__text-en" lang="en">{s.textEn}</p>
                            </div>
                          </li>
                        ))}
                      </ul>

                      <!-- ============ 04 SELECTED WORK ============ -->
                      <section class="wb-cases" aria-labelledby="cases-title">
                        <div class="wb-cases__head">
                          <h2 id="cases-title" class="reveal wb-cases__title" lang="en">SELECTED WORK</h2>
                          <div class="reveal wb-cases__intro">
                            <p class="wb-cases__intro-ja">守秘義務のため、企業名やプロジェクト名は掲載していません。業種と、向き合った問い、そして私たちが何をしたのかでご紹介します。</p>
                            <p class="wb-cases__intro-en" lang="en">Much of our work is confidential, so we don't name clients or projects. Instead, we describe each by industry, the question we worked on, and what we did.</p>
                          </div>
                        </div>
                        <ul class="wb-cases__list">
                          {cases.map((c) => (
                            <li class="reveal wb-case">
                              <p class="wb-case__industry"><span class="wb-case__industry-en" lang="en">{c.industryEn}</span><span class="wb-case__industry-ja">{c.industryJa}</span></p>
                              <div class="wb-case__question">
                                <p class="wb-case__label" lang="en">QUESTION</p>
                                <h3 class="wb-case__q">{c.questionJa}</h3>
                                <p class="wb-case__q-en" lang="en">{c.questionEn}</p>
                              </div>
                              <dl class="wb-steps">
                                {stepLabels.map((s) => (
                                  <div class="wb-steps__row">
                                    <dt class="wb-steps__label" lang="en">{s.label}</dt>
                                    <dd class="wb-steps__body">
                                      <p class="wb-steps__ja">{c.steps[s.key].ja}</p>
                                      <p class="wb-steps__en" lang="en">{c.steps[s.key].en}</p>
                                    </dd>
                                  </div>
                                ))}
                              </dl>
                            </li>
                          ))}
                          <li class="reveal wb-case wb-case--more">
                            <p class="wb-case__more-ja">ほかの事例は、ご相談の際に個別にご紹介しています。</p>
                            <p class="wb-case__more-en" lang="en">More case studies are available on request.</p>
                            <a class="wb-textlink" href="contact/index.html">プロジェクトについて相談する<span lang="en">Talk to us about a project</span></a>
                          </li>
                        </ul>
                      </section>
                    </div>
                  </section>

                  <!-- ============ 05 WONDER LAB ============ -->
                  <section id="lab" class="wb-box reveal wb-wonderlab wb-flow" aria-labelledby="lab-title">
                    <div class="wb-box reveal wb-wonderlab__inner">
                      <div class="wb-box reveal wb-wonderlab__intro">
                        <h2 id="lab-title" class="text wb-box reveal wb-wonderlab__title" lang="en">WONDER LAB</h2>
                        <p class="text wb-box reveal wb-wonderlab__subtitle" lang="en">
                          Ideas should be built, not just discussed.
                        </p>
                        <div class="wb-box reveal wb-wonderlab__intro-row">
                          <div class="wb-box reveal wb-wonderlab__lead">
                            <div class="wb-lab__heading">
                              <p class="wb-sec__heading">自分たち自身の問いも、つくることで確かめる。</p>
                              <p class="wb-lab__heading-en" lang="en">We build to explore our own questions, too.</p>
                            </div>
                            <div class="wb-box reveal wb-wonderlab__lead-ja">
                              <p>WONDER LABは、日々の仕事や暮らしの中で生まれた問いを、実際にプロダクトや実験として形にする場所です。まだ答えがないテーマに対して、まずつくってみることで見えてくることを確かめ、そこから次の問いへつなげています。</p>
                            </div>
                            <div class="wb-box reveal wb-wonderlab__lead-en" lang="en">
                              <p>WONDER LAB is a space for turning questions from our work and everyday life into real products and experiments. By making first, we discover what can't be understood through discussion alone, and use what we learn to shape the next question.</p>
                            </div>
                            <p class="reveal wb-principle wb-principle--ink wb-principle--lead">
                              <span class="wb-principle__en" lang="en">DISCOVER. MAKE. LEARN.</span>
                              <span class="wb-principle__ja">見つける。つくる。学ぶ。</span>
                            </p>
                          </div>
                          <div class="wb-box reveal wb-wonderlab__visual">
                            <img
                              class="wb-box wb-wonderlab__visual-image"
                              alt=""
                              src="images/wl-image.webp"
                              width="1003"
                              height="822"
                              loading="lazy"
                              decoding="async"
                            />
                          </div>
                        </div>
                      </div>
                      <div class="wb-box reveal wb-wonderlab__carousel">
                        <div class="wb-box wb-wonderlab__carousel-viewport" data-carousel-viewport>
                          <div class="wb-box wb-wonderlab__products" data-carousel-track>
                            {labProjects.map((p) => (
                              <article class={`wb-box wb-wonderlab__product wb-wonderlab__product-${p.key}`} aria-labelledby={`lab-${p.key}`}>
                                <div class="wb-box reveal wb-wonderlab__product-aside">
                                  {p.url ? (
                                    <a class="wb-box wb-wonderlab__product-logo-link" href={p.url} target="_blank" rel="noopener">
                                      <img class="wb-box wb-wonderlab__product-logo" alt={p.name} src={p.logo} />
                                    </a>
                                  ) : (
                                    <img class="wb-box wb-wonderlab__product-logo" alt={p.name} src={p.logo} />
                                  )}
                                  {p.url && (
                                    <a class="text link wb-box reveal wb-wonderlab__product-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel}</a>
                                  )}
                                </div>
                                <div class="wb-box reveal wb-wonderlab__product-body">
                                  <p class="wb-lab__theme">
                                    <span class="wb-lab__name" id={`lab-${p.key}`} lang="en">{p.name}</span>
                                    <span class="wb-lab__theme-ja">{p.themeJa}</span>
                                    <span class="wb-lab__theme-en" lang="en">{p.themeEn}</span>
                                  </p>
                                  <div class="wb-box reveal wb-wonderlab__product-heading">
                                    <h3 class="text wb-box reveal wb-wonderlab__product-heading-ja">{p.questionJa}</h3>
                                    <p class="text wb-box reveal wb-wonderlab__product-heading-en" lang="en">{p.questionEn}</p>
                                  </div>
                                  <div class="wb-box reveal wb-wonderlab__product-text">
                                    <div class="wb-box reveal wb-wonderlab__product-ja"><p>{p.contextJa}</p></div>
                                    <div class="wb-box reveal wb-wonderlab__product-en" lang="en"><p>{p.contextEn}</p></div>
                                  </div>
                                  <dl class="wb-steps">
                                    {stepLabels.map((s) => (
                                      <div class="wb-steps__row">
                                        <dt class="wb-steps__label" lang="en">{s.label}</dt>
                                        <dd class="wb-steps__body">
                                          <p class="wb-steps__ja">{p.steps[s.key].ja}</p>
                                          <p class="wb-steps__en" lang="en">{p.steps[s.key].en}</p>
                                        </dd>
                                      </div>
                                    ))}
                                  </dl>
                                </div>
                              </article>
                            ))}
                          </div>
                        </div>
                        <div class="wb-box wb-wonderlab__carousel-arrows" data-carousel-arrows>
                          <button
                            type="button"
                            class="wb-box wb-wonderlab__carousel-arrow"
                            data-carousel-prev
                            aria-label="前のプロジェクトを見る"
                          >
                            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
                              ><polyline
                                points="15 18 9 12 15 6"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              ></polyline></svg
                            >
                          </button>
                          <button
                            type="button"
                            class="wb-box wb-wonderlab__carousel-arrow"
                            data-carousel-next
                            aria-label="次のプロジェクトを見る"
                          >
                            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
                              ><polyline
                                points="9 18 15 12 9 6"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              ></polyline></svg
                            >
                          </button>
                        </div>
                        <div class="wb-box wb-wonderlab__carousel-nav" data-carousel-nav>
                          <div class="wb-box wb-wonderlab__carousel-dots" data-carousel-dots></div>
                        </div>
                      </div>
                      <div class="reveal wb-lab__closing">
                        <p class="wb-lab__closing-ja">デジタルでも、森でも、私たちがやっていることは同じです。</p>
                        <p class="wb-lab__closing-en" lang="en">Whether it's a digital product or a forest, what we do is the same.</p>
                        <p class="wb-principle wb-principle--ink">
                          <span class="wb-principle__en" lang="en">DISCOVER. MAKE. LEARN.</span>
                          <span class="wb-principle__ja">見つける。つくる。学ぶ。</span>
                        </p>
                      </div>
                    </div>
                  </section>
                </div>

                <!-- ============ 06 OUR BELIEF ============ -->
                <section class="wb-belief wb-flow" aria-labelledby="belief-title">
                  <div class="wb-belief__inner">
                    <h2 id="belief-title" class="reveal wb-row-title wb-belief__label" lang="en">OUR BELIEF</h2>
                    <div class="wb-belief__body">
                      <div class="wb-belief__list" lang="en">
                        <p class="reveal wb-belief__line wb-belief__line--1">Design is not</p>
                        <p class="reveal wb-belief__line wb-belief__line--2">decoration.</p>
                      </div>
                      <p class="reveal wb-belief__ja">デザインは、見た目を整えることだけではありません。複雑なものを整理し、まだ見えていない問題を見つけ、人が理解し、判断し、行動できる状態をつくること。そして実際につくり、そこから学ぶこと。私たちは、それもデザインだと考えています。</p>
                      <p class="reveal wb-belief__ja wb-belief__ja--next">AIが多くのものをつくれるようになるほど、何を問い、何を任せ、何を人が判断するのかを決めることが大切になります。その判断を設計することも、これからのデザインの役割だと考えています。</p>
                      <p class="reveal wb-belief__en wb-belief__en--first" lang="en">Design isn't only about how things look. It's about bringing order to complexity, finding problems no one has named yet, and helping people understand, decide, and act. It's also about building things and learning from them. That, too, is design.</p>
                      <p class="reveal wb-belief__en" lang="en">As AI takes on more of the making, deciding what to ask, what to delegate, and what people must judge for themselves matters more. Designing those decisions is part of design's work, too.</p>
                      <p class="reveal wb-belief__closing">
                        <span class="wb-belief__closing-en" lang="en">Design is how we discover, make and learn.</span>
                        <span class="wb-belief__closing-ja">デザインは、見つけ、つくり、学ぶための方法です。</span>
                      </p>
                    </div>
                  </div>
                </section>

                <div class="wb-box reveal wb-lower wb-lower--company">
                  <!-- ============ 07 ABOUT ============ -->
                  <section id="about" class="wb-row-sec wb-flow" aria-labelledby="about-title">
                    <div class="wb-row-sec__inner">
                      <h2 id="about-title" class="reveal wb-row-title" lang="en">ABOUT</h2>
                      <dl class="reveal wb-company-list">
                        {company.map((row) => (
                          <div class="wb-company-list__row">
                            <dt class="wb-company-list__label">{row.label}</dt>
                            <dd class="wb-company-list__value">
                              {row.list ? (
                                <ul class="wb-company-list__services" lang="en">
                                  {row.list.map((item) => <li>{item}</li>)}
                                </ul>
                              ) : (
                                <p class="wb-company-list__ja">{row.ja}</p>
                              )}
                              <p class="wb-company-list__en" lang={row.list ? "ja" : "en"}>{row.en}</p>
                            </dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  </section>

                  <!-- ============ 08 SECURITY & GOVERNANCE ============ -->
                  <section class="wb-row-sec wb-flow" aria-labelledby="governance-title">
                    <div class="wb-row-sec__inner">
                      <h2 id="governance-title" class="reveal wb-row-title" lang="en">SECURITY &amp; GOVERNANCE</h2>
                      <div class="reveal wb-row-sec__body">
                        <p class="wb-row-sec__lead">安心してプロジェクトをお任せいただくために。</p>
                        <p class="wb-row-sec__ja">企業とのプロジェクトを安全に進めるため、情報管理、セキュリティ、ガバナンス体制の整備に継続して取り組んでいます。意思決定の公平性と透明性を高めるため、業務執行に対する監督機能の充実と、適正な情報開示のための社内体制づくりを進めています。個人情報の取り扱いについては、<a class="wb-inline-link" href="privacy/index.html">プライバシーポリシー</a>をご覧ください。</p>
                        <p class="wb-row-sec__en" lang="en">To keep client projects secure, we continue to strengthen our information management, security, and governance. To keep decision-making fair and transparent, we are reinforcing oversight of business execution and building the internal systems needed for appropriate disclosure. For how we handle personal information, please see our Privacy Policy.</p>
                      </div>
                    </div>
                  </section>

                  <!-- ============ 09 CONTACT ============ -->
                  <section id="contact" class="wb-row-sec wb-flow" aria-labelledby="contact-title">
                    <div class="wb-row-sec__inner">
                      <h2 id="contact-title" class="reveal wb-row-title" lang="en">CONTACT</h2>
                      <div class="reveal wb-row-sec__body">
                        <p class="wb-row-sec__lead">まだ具体的な企画になっていない段階でも構いません。</p>
                        <p class="wb-row-sec__ja">新しいサービス、UX/UI、PoC、DXについて、一緒に問いを整理するところからご相談ください。</p>
                        <p class="wb-row-sec__en" lang="en">You don't need to have everything figured out before you contact us. If you're exploring a new service, product, UX challenge, prototype, or digital transformation, we can start by defining the question together.</p>
                        <a href="contact/index.html" class="link wb-box wb-company__contact"
                          ><div class="wb-box wb-company__contact-text">
                            <p class="text wb-box wb-company__contact-title">お問い合わせ</p>
                            <p class="text wb-box wb-company__contact-note" lang="en">
                              Start a conversation
                            </p>
                          </div>
                          <i class="icon material-icons wb-box wb-company__contact-icon" aria-hidden="true"
                            >keyboard_arrow_right</i
                          ></a
                        >
                      </div>
                    </div>
                  </section>
                </div>
                <footer class="wb-box reveal wb-footer">
                  <div class="wb-box reveal wb-footer__inner">
                    <p class="text wb-box reveal wb-footer__copyright">
                      © WONDER BROTHERS INC. All rights reserved.
                    </p>
                    <a href="privacy/index.html" class="text link wb-box reveal wb-footer__privacy"
                      >Privacy Policy</a
                    >
                  </div>
                </footer>
              </div>
  </div></div></div>
</Base>
