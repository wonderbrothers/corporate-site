---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/content.css";

const items = (await getCollection("works", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="実績 | 株式会社ワンダーブラザース"
  description="株式会社ワンダーブラザースの制作実績一覧です。"
  path="/works/"
>
  <div class="content-page">
    <SiteHeader />
    <main class="content-main">
      <div class="content-card">
        <h1 class="page-title"><span class="page-title__en">WORKS</span>実績</h1>
        {
          items.length === 0 ? (
            <p class="empty">実績はまだありません。</p>
          ) : (
            <ul class="works-grid">
              {items.map((item) => (
                <li>
                  <a class="works-grid__link" href={`/works/${item.id}/`}>
                    {item.data.thumbnail && (
                      <img class="works-grid__thumb" src={item.data.thumbnail} alt="" loading="lazy" />
                    )}
                    <p class="works-grid__title">{item.data.title}</p>
                    {item.data.client && <p class="works-grid__client">{item.data.client}</p>}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </main>
    <SiteFooter />
  </div>
</Base>
